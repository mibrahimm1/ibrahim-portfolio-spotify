{
  "name": "spotify-style-portfolio",
  "version": "1.0.0",
  "description": "A Spotify-inspired developer portfolio: static, fast, mobile-ready, with a dev-only content dashboard.",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "npm run content:validate && next build && node scripts/secure-export.mjs && node scripts/verify-build.mjs",
    "preview": "node scripts/serve-out.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "lint": "next lint",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:validate": "vitest run tests/unit/content.test.ts",
    "content:reset": "node scripts/content-reset.mjs",
    "setup": "node scripts/setup-fork.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
