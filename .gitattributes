# Normalise text to LF in the repo so forks on any OS get identical files.
* text=auto eol=lf

# Binary assets: never touch line endings or diff them as text.
*.pdf    binary
*.woff2  binary
*.woff   binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.avif   binary
*.gif    binary
*.ico    binary
